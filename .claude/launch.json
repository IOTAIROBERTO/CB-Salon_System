{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "salon-control-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "salon-control-app",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "app-clientas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app-clientas",
        "run",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "dexie-falso",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app-clientas", "run", "dexie:falso"],
