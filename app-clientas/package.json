{
  "name": "app-clientas",
  "version": "0.1.0",
  "description": "App de clientas de Cristina Borquez Beauty Salon (web instalable y Google Play)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dexie:falso": "node scripts/dexie-falso.mjs",
    "api:local": "wrangler pages dev dist --port 8788 --binding DEXIE_URL=http://127.0.0.1:8799 DEXIE_CLIENT_ID=local DEXIE_CLIENT_SECRET=local"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
